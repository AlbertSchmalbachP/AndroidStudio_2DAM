<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TituloPantalla">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/azul_principal</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="CampoFormulario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="BotonPrincipal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/turquesa</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="BotonSecundario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/azul_principal</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="TextoResultado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>
</resources>