<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Registro de entrenamiento" style="@style/TituloPantalla" />
        <!-- TODO: construye la interfaz completa siguiendo los id del PDF:
             etNombre (texto), etMinutos (entero), etIntensidad (entero), btnRegistrar, btnLimpiar, tvResultado.
             Aplica los estilos definidos en res/values/styles.xml. -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tu nombre"
            android:inputType="textCapWords"
            />
        <EditText
            android:id="@+id/etMinutos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce unos minutos"
            android:inputType="numberDecimal|numberSigned"
            />
        <EditText
            android:id="@+id/etIntensidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce una intensidad"
            android:inputType="numberDecimal|numberSigned"
            />
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar"
            />
        <Button
            android:id="@+id/btnLimpiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar"
            />
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Resultado"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
