<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro de entrenamiento"
            style="@style/TituloPantalla" />

        <EditText
            android:id="@+id/etNombre"
            style="@style/CampoFormulario"
            android:hint="Tu nombre"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etMinutos"
            style="@style/CampoFormulario"
            android:hint="Minutos de entrenamiento (1-300)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etIntensidad"
            style="@style/CampoFormulario"
            android:hint="Intensidad (1-10)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnRegistrar"
            style="@style/BotonPrincipal"
            android:text="Registrar" />

        <Button
            android:id="@+id/btnLimpiar"
            style="@style/BotonSecundario"
            android:text="Limpiar" />

        <TextView
            android:id="@+id/tvResultado"
            style="@style/TextoResultado"
            android:text="Introduce los datos y pulsa Registrar." />
    </LinearLayout>
</ScrollView>