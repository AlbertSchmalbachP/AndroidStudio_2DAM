<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pedido con gastos de envío" style="@style/TituloPantalla" />
        <EditText android:id="@+id/etImporte" style="@style/CampoFormulario"
            android:hint="Importe de artículos (€)" android:inputType="numberDecimal|numberSigned" />
        <EditText android:id="@+id/etPeso" style="@style/CampoFormulario"
            android:hint="Peso del paquete (kg)" android:inputType="numberDecimal|numberSigned" />
        <CheckBox android:id="@+id/cbUrgente"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Envío urgente (+4 €)" />
        <Button android:id="@+id/btnCalcular" style="@style/BotonPrincipal" android:text="Calcular pedido" />
        <Button android:id="@+id/btnLimpiar" style="@style/BotonSecundario" android:text="Limpiar" />
        <TextView android:id="@+id/tvResultado" style="@style/TextoResultado"
            android:text="Introduce los datos del envío." />
    </LinearLayout>
</ScrollView>
